# uestc-create 用户信息（示例模板）
# 首次使用：把本文件复制为 user.yaml 后再填写。
# user.yaml 已被 .gitignore 忽略，不会被随包分发；这些信息只保存在你本机，不会写入技能包或任何示例。

name: ""          # 姓名，如：张三
student_id: ""    # 学号，如：2025xxxxxx
school: ""        # 学院全称，如：信息与软件工程学院
major: ""         # 专业，如：软件工程
class_no: ""      # 班号（可选，部分模板需要）
email: ""         # 可选
